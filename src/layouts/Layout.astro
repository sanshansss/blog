---
import type { Language } from '@/i18n/config'
import Button from '@/components/Button.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Navbar from '@/components/Navbar.astro'
import CodeCopyButton from '@/components/Widgets/CodeCopyButton.astro'
import GithubCard from '@/components/Widgets/GithubCard.astro'
import ImageZoom from '@/components/Widgets/ImageZoom.astro'
import MediaEmbed from '@/components/Widgets/MediaEmbed.astro'
import SoundEffect from '@/components/Widgets/SoundEffect.astro'
import { themeConfig } from '@/config'
import Head from '@/layouts/Head.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/comment.css'
import '@/styles/extension.css'
import '@/styles/figures.css'
import '@/styles/global.css'
import '@/styles/lqip.css'
import '@/styles/markdown.css'
import '@/styles/transition.css'
// Reading (serif): Newsreader + 思源宋体（variable, 按 unicode-range 分片）
// standard.css keeps the opsz axis, so 17px body gets the text cut and 36px titles the display cut
import '@fontsource-variable/newsreader/standard.css'
import '@fontsource-variable/noto-serif-sc/wght.css'
// Interface (sans): Plus Jakarta Sans + 系统黑体（HarmonyOS Sans / 苹方 / 微软雅黑）
import '@fontsource-variable/plus-jakarta-sans/wght.css'
// Reading (serif): Source Serif 4 + 思源宋体 400 / 600
// Interface (sans): Plus Jakarta Sans + 系统黑体（HarmonyOS Sans / 苹方 / 微软雅黑）

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
  supportedLangs?: Language[]
}

const { postTitle, postDescription, postSlug, supportedLangs = [] } = Astro.props
const { isPost } = getPageInfo(Astro.url.pathname)
const fontStyle = themeConfig.global.fontStyle === 'serif' ? 'font-serif' : 'font-sans'
const MarginBottom = isPost && themeConfig.comment.enabled
  ? 'mb-10' // Post page with comment
  : 'mb-12' // Other pages without comment
---

<html
  lang={Astro.currentLocale}
  class:list={[
    isPost ? 'scroll-smooth' : '',
  ]}
>
  <Head {postTitle} {postDescription} {postSlug} />
  <body class:list={[fontStyle, { 'post-page': isPost }]}>
    <div
      class:list={[
        'w-full',
        // mobile / tablet shell
        'max-lg:(mx-auto max-w-205.848 min-h-vh min-h-dvh px-[min(7.25vw,3.731rem)] py-10)',
        // desktop shell for pages without the article layout
        'lg:(mx-[max(5.75rem,calc(50vw-34.25rem))] my-20 max-w-[min(calc(75vw-16rem),42rem)] min-h-full p-0)',
        { 'post-layout': isPost },
      ]}
    >
      <Header />
      <Navbar />
      <main class={MarginBottom}>
        <slot />
      </main>
      <Footer />
    </div>
    <Button supportedLangs={supportedLangs} />
    <SoundEffect />
    <CodeCopyButton />
    <GithubCard />
    <MediaEmbed />
    <ImageZoom />
  </body>
</html>

<style>
  .post-layout {
    max-width: 49rem;
    padding-inline: clamp(1.125rem, 4vw, 2.5rem);
  }

  @media (min-width: 1024px) {
    .post-page {
      --post-layout-max: 80rem;
      --post-gutter: clamp(2.75rem, 3.5vw, 3.5rem);
      --post-column-gap: clamp(1.25rem, 2.25vw, 1.75rem);
      --site-column-width: 14rem;
      --site-column-right: max(var(--post-gutter), calc((100% - var(--post-layout-max)) / 2));
    }

    .post-layout {
      width: calc(100% - 2 * var(--post-gutter));
      max-width: var(--post-layout-max);
      margin-inline: auto;
      padding-inline: 0 calc(var(--site-column-width) + var(--post-column-gap));
    }
  }

  @media (1024px <= width < 1152px) {
    .post-layout > main {
      max-width: 44rem;
      margin-inline: auto;
    }
  }
</style>

