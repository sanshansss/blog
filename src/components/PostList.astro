---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import PinIcon from '@/assets/icons/pin-icon.svg'
import PostDate from '@/components/PostDate.astro'
import { getPostPath } from '@/i18n/path'
import { getPostDescription } from '@/utils/description'

export interface Props {
  posts: Post[]
  lang: Language
  pinned?: boolean
}

const { posts, lang, pinned = false } = Astro.props
---

<ul class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
  {posts.map((post, index) => {
    const slug = post.data.abbrlink || post.id
    const tags = post.data.tags ?? []
    const hasCover = Boolean(post.data.cover)
    // the first pinned post spans both columns as the featured slot
    const featured = pinned && index === 0

    return (
      <li class:list={[{ 'sm:col-span-2': featured }]}>
        <a
          href={getPostPath(slug, lang)}
          class:list={[
            'group flex h-full flex-col rounded-xl border border-secondary/12 bg-secondary/[0.04] p-4.5',
            'transition-colors ease-out hover:(border-secondary/25 bg-secondary/[0.08])',
          ]}
          transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          {/* cover slot — renders only when the post declares `cover` */}
          {hasCover && (
            <div class="mb-3.5 overflow-hidden rounded-lg bg-secondary/5">
              <img
                src={post.data.cover}
                alt=""
                loading="lazy"
                class="aspect-16/9 w-full object-cover"
              />
            </div>
          )}

          {/* meta row: date · reading time, pinned mark on the right */}
          <div class="mb-2.5 flex items-baseline justify-between gap-2 text-3.1 c-secondary/60 font-time">
            <div transition:name={`time-${slug}${lang ? `-${lang}` : ''}`} data-disable-theme-toggle-transition>
              <PostDate
                date={post.data.published}
                minutes={post.remarkPluginFrontmatter.minutes}
              />
            </div>
            {pinned && (
              <PinIcon
                aria-hidden="true"
                class="aspect-square w-3 shrink-0 translate-y-0.1em c-secondary/50"
                fill="currentColor"
              />
            )}
          </div>

          {/* title */}
          <h3
            class:list={[
              'line-clamp-2 font-medium leading-[1.45] text-balance c-primary transition-colors',
              featured ? 'text-5' : 'text-4.25',
            ]}
          >
            {post.data.title}
          </h3>

          {/* description */}
          {getPostDescription(post, 'list') && (
            <p class="line-clamp-2 mt-2 text-3.25 c-secondary/70 leading-[1.65] font-navbar sm:line-clamp-3">
              {getPostDescription(post, 'list')}
            </p>
          )}

          {/* tags */}
          {tags.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-1.5 pt-3.5">
              {tags.slice(0, 3).map(tag => (
                <span class="border border-secondary/18 rounded-full px-2 py-0.25 text-2.85 c-secondary/60 leading-[1.5] font-navbar">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      </li>
    )
  })}
</ul>
