---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import PostDate from '@/components/PostDate.astro'
import { getPostPath } from '@/i18n/path'
import { getPostDescription } from '@/utils/description'

export interface Props {
  posts: Post[]
  lang: Language
  editorial?: boolean
}

const { posts, lang, editorial = false } = Astro.props
---

<ul class={editorial ? 'editorial-list' : 'grid grid-cols-1 items-start gap-4 sm:grid-cols-2'}>
  {posts.map((post, index) => {
    const slug = post.data.abbrlink || post.id
    const tags = post.data.tags ?? []
    const hasCover = Boolean(post.data.cover)
    const description = getPostDescription(post, 'list')

    return (
      <li
        class={editorial ? 'editorial-card' : 'home-card'}
        style={editorial
? undefined
: `--card-i: ${index};`}
        data-tags={editorial
? JSON.stringify(tags)
: undefined}
      >
        <a
          href={getPostPath(slug, lang)}
          class={editorial
            ? 'editorial-card-link'
            : 'home-card-link group flex h-full flex-col rounded-xl border border-secondary/12 bg-secondary/[0.04] p-4.5 hover:(border-secondary/25 bg-secondary/[0.08])'}
        >
          {editorial && <span class="editorial-card-arrow" aria-hidden="true">→</span>}
          {/* cover slot — renders only when the post declares `cover` */}
          {!editorial && hasCover && (
            <div class="mb-3.5 overflow-hidden rounded-lg bg-secondary/5">
              <img
                src={post.data.cover}
                alt=""
                loading="lazy"
                class="aspect-16/9 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              />
            </div>
          )}

          <div class={editorial ? 'editorial-card-date' : 'mb-2.5 flex items-baseline justify-between gap-2 text-3.1 c-secondary/60 font-time'}>
            <div
              transition:name={`time-${slug}${lang
? `-${lang}`
: ''}`}
              data-disable-theme-toggle-transition
            >
              <PostDate
                date={post.data.published}
                minutes={post.remarkPluginFrontmatter.minutes}
              />
            </div>
          </div>

          {/* title */}
          <h3
            class={editorial ? 'editorial-card-title' : 'line-clamp-2 font-medium leading-[1.45] text-balance c-primary transition-colors text-4.25'}
            transition:name={`post-${slug}${lang
? `-${lang}`
: ''}`}
            data-disable-theme-toggle-transition
          >
            {post.data.title}
          </h3>

          {/* description */}
          {description && (
            <p class={editorial ? 'editorial-card-description' : 'line-clamp-2 mt-2 text-3.25 c-secondary/70 leading-[1.65] font-navbar sm:line-clamp-3'}>
              {description}
            </p>
          )}

          {/* tags */}
          {tags.length > 0 && (
            <div class={editorial ? 'editorial-card-tags' : 'mt-auto flex flex-wrap gap-1.5 pt-3.5'}>
              {tags.slice(0, 3).map(tag => (
                <span class={editorial ? undefined : 'border border-secondary/18 rounded-full px-2 py-0.25 text-2.85 c-secondary/60 leading-[1.5] font-navbar'}>
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      </li>
    )
  })}
</ul>
